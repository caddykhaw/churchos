# Template only — never put real values here. Copy to `.env` and fill in.
# Anything committed to this file is public; keep all secrets in `.env` (gitignored).

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Cloudflare
# Create a scoped API token (Zone > DNS > Edit on the churchos.my zone) at
# https://dash.cloudflare.com/profile/api-tokens — never a Global API Key.
CLOUDFLARE_EMAIL=you@example.com
CLOUDFLARE_API_TOKEN=your_scoped_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_PAGES_PROJECT=churchos-platform

# App
NUXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=generate_with_openssl_rand_base64_32
