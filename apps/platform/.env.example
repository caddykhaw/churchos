# ChurchOS Platform App Environment
# Copy to .env before running

# Stripe
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET

# Resend (for billing emails)
RESEND_API_KEY=re_xxx

# App URLs
PLATFORM_URL=https://app.churchos.my
MARKETING_URL=https://churchos.my

# Supabase
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_KEY=eyJxxx
