# ChurchOS Platform App Environment
# Template only — never put real values here. Copy to `.env` and fill in.

# Turso (libSQL)
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Clerk
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_key
NUXT_CLERK_SECRET_KEY=sk_test_or_sk_live_key

# Session signing
JWT_SECRET=generate_with_openssl_rand_base64_32

# Stripe (billing — later phase)
STRIPE_SECRET_KEY=sk_test_or_sk_live_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET

# Resend (for billing emails)
RESEND_API_KEY=re_xxx

# App URLs
PLATFORM_URL=https://app.churchos.my
MARKETING_URL=https://churchos.my
