# Generated locally — DO NOT commit
POSTGRES_PASSWORD=generate_with_openssl_rand_base64_32
# Same password, percent-encoded for postgresql:// URIs (base64 passwords
# contain / and = which break the URI). Encode with:
#   python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$(grep '^POSTGRES_PASSWORD=' .env | cut -d= -f2-)"
POSTGRES_PASSWORD_ENCODED=
JWT_SECRET=generate_with_openssl_rand_base64_32
ANON_KEY=generate_with_python_jwt_helperSERVICE_KEY

# 32-byte hex key used by postgres-meta to encrypt secrets in DB metadata
PG_META_CRYPTO_KEY=generate_with_openssl_rand_hex_24

# GoTrue reuses JWT_SECRET (HS256) above — it must stay in sync with the
# secret used to mint ANON_KEY/SERVICE_KEY. Do not add RSA GOTRUE_JWT_KEYS:
# that makes GoTrue reject the HS256 service key on admin API calls.

# Generate ANON_KEY and SERVICE_KEY (Python helper):
#   python3 -c "import json,base64,hmac,hashlib,time; #     s='$JWT_SECRET'; #     h={'alg':'HS256','typ':'JWT'}; #     p={'aud':'authenticated','exp':int(time.time())+315360000,'iat':int(time.time()),'iss':'supabase','ref':'churchos','role':'anon'}; #     bb=lambda d: base64.urlsafe_b64encode(json.dumps(d,separators=(',',':')).encode()).rstrip(b'=').decode(); #     si=f"{bb(h)}.{bb(p)}".encode(); #     print(f"{bb(h)}.{bb(p)}."+base64.urlsafe_b64encode(hmac.new(s.encode(),si,hashlib.sha256).digest()).rstrip(b'=').decode())"
